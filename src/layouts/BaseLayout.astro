---
const title = Astro.props.title || "Bruin AI Safety";
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={Astro.props.desc || "Bruin AI Safety"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <style>
      #widenav a {
        @apply rounded-lg py-1 px-2 text-sm hover:underline decoration-ucla-gold decoration-2;

        &.active {
          @apply underline;
        }
      }

      #narrownav > a {
        @apply block my-2 text-slate-700;
      }

      .dropdown {
        @apply relative;

        & > a {
          @apply relative -top-0.5;
        }
      }

      .dropdown-reveal {
        @apply absolute bg-white p-2 text-right -right-2 left-auto whitespace-nowrap;

        & > a {
          @apply text-slate-700 hover:underline decoration-ucla-gold decoration-2 block;
        }
      }
    </style>
    <script>
      document.querySelector("#hamburger")?.addEventListener("click", () => {
        document.querySelector("#narrownav")?.classList.toggle("hidden");
      });
      document.querySelectorAll(".dropdown").forEach((dropdown) => {
        let toggle = () =>
          dropdown
            .querySelector(".dropdown-reveal")
            ?.classList.toggle("hidden");
        dropdown.addEventListener("mouseover", toggle);
        dropdown.addEventListener("mouseout", toggle);
      });
    </script>
  </head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-RTTEHHSKNL"
  ></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", "G-RTTEHHSKNL");
  </script>
  <body class="flex flex-col h-screen justify-between">
    <header class="py-6">
      <div class="mx-auto max-w-7xl px-6 sm:px-6 lg:px-8">
        <nav class="relative">
          <div class="flex justify-between text-slate-700 text-lg text-center">
            <a href="/">
              <img
                alt="Bruin AI Safety logo"
                src="/assets/logo.png"
                class="h-8 w-auto px-2 inline-block"
              />
               Bruin AI Safety
            </a>
            <div
              id="widenav"
              class="hidden md:flex items-center gap-x-1 md:gap-x-8"
            >
              <a
                class={currentPath === "/fellowships" ? "active" : ""}
                href="/fellowships"
              >
                Fellowship
              </a>
              <a
                class={currentPath === "/reading-groups" ? "active" : ""}
                href="/reading-groups"
              >
                Reading Group
              </a>
              <div class="dropdown">
                <a
                  class={currentPath === "/projects" ? "active" : ""}
                  href="/projects"
                >
                  Projects
                </a>
                <div class="dropdown-reveal hidden">
                  <a
                    class={currentPath === "/projects/ideas-to-policy"
                      ? "active"
                      : ""}
                    href="/projects/ideas-to-policy"
                  >
                    Ideas to Policy
                  </a>
                  <a
                    class={currentPath === "/projects/ai-in-the-classroom"
                      ? "active"
                      : ""}
                    href="/projects/ai-in-the-classroom"
                  >
                    AI in the Classroom
                  </a>
                </div>
              </div>
              <div class="dropdown">
                <a
                  class={currentPath === "/who-we-are" ? "active" : ""}
                  href="/who-we-are"
                >
                  Who We Are
                </a>
                <div class="dropdown-reveal hidden">
                  <a href="//blog.aisafetyatucla.org/"> Blog</a>
                </div>
              </div>
              <a
                class="text-slate-100 bg-slate-900 rounded-lg hover:text-ucla-gold"
                target="_blank"
                rel="noopener noreferrer"
                href="https://discord.gg/5vHgayXspH"
              >
                Join Us
              </a>
            </div>
            <div class="block md:hidden" id="hamburger">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-8 h-8"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
              </svg>
            </div>
          </div>
          <div id="narrownav" class="hidden border-t-2 mt-4 border-ucla-gold">
            <a href="/fellowships">Fellowship</a>
            <hr />
            <a href="/reading-groups">Reading Group</a>
            <hr />
            <a href="/projects">Projects:</a>
            <a href="/projects/ideas-to-policy">Ideas to Policy</a>
            <a href="/projects/ai-in-the-classroom">AI in the Classroom</a>
            <hr />
            <a href="/who-we-are">Who We Are</a>
            <a href="//blog.aisafetyatucla.org/">Blog</a>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://discord.gg/5vHgayXspH">Join Us</a
            >
          </div>
        </nav>
      </div>
    </header>
    <main class="max-w-5xl mx-auto mb-auto w-full">
      <slot />
    </main>
    <footer
      class="py-10 bg-slate-900 text-slate-100 border-t-4 border-ucla-gold"
    >
      <div class="mx-auto max-w-7xl flex justify-between px-6">
        <p>&copy; 2025 Bruin AI Safety</p>
        <div class="flex gap-x-6 [&>a:hover]:text-ucla-gold">
          <a
            href="//blog.aisafetyatucla.org"
            target="_blank"
            rel="noopener noreferrer">Blog</a
          >
          <a
            href="//github.com/ais-ucla"
            target="_blank"
            rel="noopener noreferrer">Github</a
          >
          <a
            href="https://discord.gg/5vHgayXspH"
            target="_blank"
            rel="noopener noreferrer">Discord</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
